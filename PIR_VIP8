local hitboxBaseSizes = {}
local function restoreHitboxForChar(char)
    if not char then return end
    for _, partName in ipairs({ "Head", "UpperTorso", "LowerTorso", "Torso" }) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local base = hitboxBaseSizes[part]
            if base then part.Size = base; hitboxBaseSizes[part] = nil end
        end
    end
end
local function restoreAllHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then restoreHitboxForChar(player.Character) end
    end
end

_G.FRH_HitboxLoop = RunService.Heartbeat:Connect(function()
    if not Config.Hitbox.Enabled then restoreAllHitboxes(); return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not isWhitelisted(player) and not isTeammate(player) then
                local char = player.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local function resize(partName, multiplier)
                        local part = char:FindFirstChild(partName)
                        if part and part:IsA("BasePart") then
                            if not hitboxBaseSizes[part] then hitboxBaseSizes[part] = part.Size end
                            part.Size = hitboxBaseSizes[part] * multiplier
                            part.CanCollide = false; part.Massless = true
                        end
                    end
                    resize("Head", Config.Hitbox.HeadSize)
                    resize("UpperTorso", Config.Hitbox.TorsoSize)
                    resize("LowerTorso", Config.Hitbox.TorsoSize)
                    resize("Torso", Config.Hitbox.TorsoSize)
                end
            else restoreHitboxForChar(player.Character) end
        end
    end
end)

