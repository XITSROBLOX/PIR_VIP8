    player.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        if drawings.Billboard then pcall(function() drawings.Billboard:Destroy() end) end
        if drawings.WeaponBillboard then pcall(function() drawings.WeaponBillboard:Destroy() end) end
        local nbb, ntt, nbt = createBillboardFor(player.Name, newChar)
        drawings.Billboard = nbb
        drawings.TopText = ntt
        drawings.BotText = nbt
        local nwbb, nwl = createWeaponBillboard(player.Name, newChar)
        drawings.WeaponBillboard = nwbb
        drawings.WeaponLabel = nwl
    end)

    drawings._ApplyColors = function()
        drawings.Box.Color = ESP_Colors.Box
        drawings.Snapline.Color = ESP_Colors.Snapline
        drawings.FaceCircle.Color = ESP_Colors.Box
        drawings.HealthBar.Color = ESP_Colors.HealthBar
        for _, line in pairs(drawings.Skeleton) do line.Color = ESP_Colors.Box end
        drawings.CornerTL_H.Color = ESP_Colors.Box
        drawings.CornerTL_V.Color = ESP_Colors.Box
        drawings.CornerTR_H.Color = ESP_Colors.Box
        drawings.CornerTR_V.Color = ESP_Colors.Box
        drawings.CornerBL_H.Color = ESP_Colors.Box
        drawings.CornerBL_V.Color = ESP_Colors.Box
        drawings.CornerBR_H.Color = ESP_Colors.Box
        drawings.CornerBR_V.Color = ESP_Colors.Box
        if drawings.TopText then drawings.TopText.TextColor3 = ESP_Colors.Name end
        if drawings.BotText then drawings.BotText.TextColor3 = ESP_Colors.Distance end
        if drawings.WeaponLabel then drawings.WeaponLabel.TextColor3 = ESP_Colors.Weapon end
    end

    ESP_Cache[player] = drawings
    TrackPlayerInventory(player)
end

local function HideAllESPObjects(esp)
    if not esp then return end
    if esp.BoxOutline then esp.BoxOutline.Visible = false end
    if esp.Box then esp.Box.Visible = false end
    if esp.Snapline then esp.Snapline.Visible = false end
    if esp.FaceCircle then esp.FaceCircle.Visible = false end
    if esp.HealthBg then esp.HealthBg.Visible = false end
    if esp.HealthBar then esp.HealthBar.Visible = false end
    if esp.Skeleton then for i = 1, #esp.Skeleton do if esp.Skeleton[i] then esp.Skeleton[i].Visible = false end end end
    if esp.CornerTL_H then esp.CornerTL_H.Visible = false end
    if esp.CornerTL_V then esp.CornerTL_V.Visible = false end
    if esp.CornerTR_H then esp.CornerTR_H.Visible = false end
    if esp.CornerTR_V then esp.CornerTR_V.Visible = false end
    if esp.CornerBL_H then esp.CornerBL_H.Visible = false end
    if esp.CornerBL_V then esp.CornerBL_V.Visible = false end
    if esp.CornerBR_H then esp.CornerBR_H.Visible = false end
    if esp.CornerBR_V then esp.CornerBR_V.Visible = false end

    if esp.TopText then esp.TopText.Visible = false; esp.TopText.Text = "" end
    if esp.BotText then esp.BotText.Visible = false; esp.BotText.Text = "" end
    if esp.Billboard then
        esp.Billboard.Enabled = false
        local caixa = esp.Billboard:FindFirstChild("Caixa")
        if caixa then caixa.Visible = false end
    end

    if esp.WeaponLabel then esp.WeaponLabel.Visible = false; esp.WeaponLabel.Text = "" end
    if esp.WeaponBillboard then esp.WeaponBillboard.Enabled = false end
end

local function RemoveESP(player)
    if ESP_Cache[player] then
        local esp = ESP_Cache[player]
        HideAllESPObjects(esp)
        if esp.Billboard then pcall(function() esp.Billboard:Destroy() end) end
        if esp.WeaponBillboard then pcall(function() esp.WeaponBillboard:Destroy() end) end
        for k, v in pairs(esp) do
            if type(v) == "table" then for _, line in pairs(v) do pcall(function() line:Remove() end) end
            elseif type(v) == "userdata" then pcall(function() v:Remove() end) end
        end
        ESP_Cache[player] = nil
    end
    WeaponCache[player] = nil
end

