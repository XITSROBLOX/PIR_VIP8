local function puxarTodasAsArmas()
    if not Config.PuxarArmas.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Parent ~= char and obj.Parent ~= backpack then
            pcall(function()
                if (hrp.Position - obj.Position).Magnitude <= Config.PuxarArmas.DistanciaPuxar then
                    obj.Parent = backpack
                end
            end)
        end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Character then
                for _, child in pairs(p.Character:GetChildren()) do
                    if child:IsA("Tool") then
                        pcall(function() child.Parent = backpack end)
                    end
                end
            end
            local pb = p:FindFirstChildOfClass("Backpack")
            if pb then
                for _, tool in pairs(pb:GetChildren()) do
                    if tool:IsA("Tool") then
                        pcall(function() tool.Parent = backpack end)
                    end
                end
            end
        end
    end
end

