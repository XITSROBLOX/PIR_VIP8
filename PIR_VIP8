local function findBestCharacterPart(char)
    if not char then return nil end
    local candidates = { "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "Head" }
    for _, name in ipairs(candidates) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    if char.PrimaryPart then return char.PrimaryPart end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

local function teleportToPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false, "Invalido" end
    local myChar = LocalPlayer.Character
    if not myChar then return false, "Voce nao tem personagem" end
    local tgtChar = targetPlayer.Character
    if not tgtChar then return false, "Alvo sem personagem" end
    local targetPart = findBestCharacterPart(tgtChar)
    if not targetPart then return false, "Alvo sem BasePart" end

    saveCurrentPosition()

    local ok1 = pcall(function() myChar:PivotTo(targetPart.CFrame * CFrame.new(0, 0, 3)) end)
    if not ok1 then
        pcall(function()
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then myHrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3) end
        end)
    end
    pcall(function()
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            myHrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3)
            myHrp.Velocity = Vector3.new(0, 0, 0)
            myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
    return true, "OK"
end

local function spectatePlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false, "Invalido" end
    local tgtChar = targetPlayer.Character
    if not tgtChar then return false, "Alvo sem personagem" end
    local tgtPart = tgtChar:FindFirstChildOfClass("Humanoid")
        or tgtChar:FindFirstChild("Head")
        or tgtChar:FindFirstChild("HumanoidRootPart")
        or findBestCharacterPart(tgtChar)
    if not tgtPart then return false, "Alvo sem parte valida" end
    SpectateTarget = targetPlayer
    if Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject = tgtPart end
    return true, "OK"
end

local function stopSpectate()
    SpectateTarget = nil
    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHum and Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject = myHum end
end

local function returnToSavedPosition()
    if not SavedPosition then return end
    local char = LocalPlayer.Character
    if char then stopSpectate(); char:PivotTo(SavedPosition) end
end

