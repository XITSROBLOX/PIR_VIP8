local function buildConfigTab()
    local cp = TabPages.CONFIG
    CreateLabel(cp, "CONFIGURACOES", C.WHITE); CreateDivider(cp)
    local ci = CreateTextInput(cp, "Nome da Config", "Digite...", "")
    local cd = createDropdown(cp, "Configs Salvas", { "Nenhuma" }, "Nenhuma")
    local sb = CreateConfigButton(cp, "SALVAR")
    local lb = CreateConfigButton(cp, "CARREGAR")
    local db = CreateConfigButton(cp, "EXCLUIR")
    local cs = CreateStatusLabel(cp)

    local function RCD()
        local l = GetConfigList()
        if #l == 0 then cd.SetOptions({ "Nenhuma" }, "Nenhuma")
        else local c = cd.GetValue(); cd.SetOptions(l, table.find(l, c) and c or l[1]) end
    end
    RCD()

    sb.MouseButton1Click:Connect(function()
        local n = ci.GetValue():gsub("%s+", "_")
        if n == "" then cs.SetText("Digite um nome.", C.RED); return end
        local s, m = SaveConfig(n, false)
        if s then cs.SetText(m, C.WHITE); ci.SetValue(""); RCD()
        elseif m == "Ja existe!" then
            ShowConfirmModal("Ja existe.\nSobrescrever?", function()
                local s2, m2 = SaveConfig(n, true)
                cs.SetText(m2, s2 and C.WHITE or C.RED)
                if s2 then ci.SetValue(""); RCD() end
            end)
        else cs.SetText(m, C.RED) end
    end)
    lb.MouseButton1Click:Connect(function()
        local n = cd.GetValue()
        if n == "Nenhuma" then cs.SetText("Selecione.", C.RED); return end
        local s, m = LoadConfig(n); cs.SetText(m, s and C.WHITE or C.RED)
        if s then RefreshUI() end
    end)
    db.MouseButton1Click:Connect(function()
        local n = cd.GetValue()
        if n == "Nenhuma" then cs.SetText("Selecione.", C.RED); return end
        ShowConfirmModal("Excluir: " .. n .. "?", function()
            local s, m = DeleteConfig(n)
            cs.SetText(m, s and C.WHITE or C.RED)
            if s then RCD() end
        end)
    end)

    CreateDivider(cp)
    CreateLabel(cp, "TECLAS", C.WHITE)
