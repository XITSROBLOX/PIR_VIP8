local function createFOVCircles()
    if FOVCircleOuter then FOVCircleOuter:Remove(); FOVCircleOuter = nil end
    if FOVCircleInner then FOVCircleInner:Remove(); FOVCircleInner = nil end
    if not Drawing then return end
    FOVCircleOuter = Drawing.new("Circle"); FOVCircleOuter.Thickness = 3; FOVCircleOuter.NumSides = 64; FOVCircleOuter.Radius = Config.Aimbot.FOV
    FOVCircleOuter.Filled = false; FOVCircleOuter.Transparency = 1; FOVCircleOuter.Color = C.FOV_OUTER; FOVCircleOuter.Visible = false
    FOVCircleInner = Drawing.new("Circle"); FOVCircleInner.Thickness = 1.5; FOVCircleInner.NumSides = 64; FOVCircleInner.Radius = Config.Aimbot.FOV
    FOVCircleInner.Filled = false; FOVCircleInner.Transparency = 1; FOVCircleInner.Color = C.FOV_INNER; FOVCircleInner.Visible = false
end

_G.FRH_FovLoop = RunService.RenderStepped:Connect(function()
    if not Camera then return end
    if Config.Aimbot.DrawFOV and Config.Aimbot.Enabled then
        if not FOVCircleOuter or not FOVCircleInner then createFOVCircles() end
        if FOVCircleOuter and FOVCircleInner then
            if FOVCircleInner.Radius ~= Config.Aimbot.FOV then
                FOVCircleInner.Radius = Config.Aimbot.FOV
            end
            if FOVCircleOuter.Radius ~= Config.Aimbot.FOV then
                FOVCircleOuter.Radius = Config.Aimbot.FOV
            end

            local pos
            if Config.Aimbot.HoldMode == "Always" then pos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            else pos = UserInputService:GetMouseLocation() end
            FOVCircleOuter.Position = pos
            FOVCircleOuter.Color = C.FOV_OUTER; FOVCircleOuter.Visible = true
            FOVCircleInner.Position = pos
            FOVCircleInner.Color = C.FOV_INNER; FOVCircleInner.Visible = true
        end
    else
        if FOVCircleOuter then FOVCircleOuter.Visible = false end
        if FOVCircleInner then FOVCircleInner.Visible = false end
    end
end)

