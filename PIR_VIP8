local function isWhitelisted(c)
    local name
    if typeof(c) == "Instance" then
        if c:IsA("Player") then name = c.Name
        elseif c:IsA("Model") then local p = Players:GetPlayerFromCharacter(c); name = p and p.Name or c.Name end
    end
    if not name then return false end
    return Config.Whitelist.Players[name] == true
end

local function isTeammate(c)
    if not Config.Aimbot.TeamCheck then return false end
    local player
    if typeof(c) == "Instance" and c:IsA("Player") then player = c
    elseif typeof(c) == "Instance" and c:IsA("Model") then player = Players:GetPlayerFromCharacter(c) end
    if not player or player == LocalPlayer then return false end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
    if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.TeamColor == player.TeamColor then return true end
    return false
end

local function isVisibleWallCheck(targetPart)
    if not Config.Aimbot.WallCheck then return true end
    if not Camera or not targetPart then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = { myChar, Camera }
    for _, c in ipairs(myChar:GetDescendants()) do if c:IsA("BasePart") then table.insert(exclude, c) end end
    rp.FilterDescendantsInstances = exclude
    local rr = Workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rp)
    if rr then
        local tc = targetPart.Parent
        if tc and rr.Instance:IsDescendantOf(tc) then return true end
        return false
    end
    return true
end

local function getAllTargets()
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(targets, { Kind = "Player", Player = player, Char = player.Character })
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum then
                if not Players:GetPlayerFromCharacter(obj) then table.insert(targets, { Kind = "NPC", Char = obj, Humanoid = hum }) end
            end
        end
    end
    return targets
end

local function isReallyDead(hum)
    if not hum then return true end
    if hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    local char = hum.Parent
    if char then
        local head = char:FindFirstChild("Head")
        if head and head.Transparency >= 1 then return true end
    end
    return false
end

-- ⭐ getAimPart REFORÇADO: Head / Torso / Pelvis
local function getAimPart(char)
    if not char then return nil end
    local mode = Config.Aimbot.Humanize

    if mode == "Head" then
        return char:FindFirstChild("Head")
    elseif mode == "Torso" then
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Head")
    elseif mode == "Pelvis" then
        return char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Head")
    end
    return char:FindFirstChild("Head")
end

local function isTargetVisible(char)
    if not Config.Aimbot.Visible then return true end
    if not char then return false end
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local isInvisible = true
    if head and head.Transparency < 1 then isInvisible = false end
    if torso and torso.Transparency < 1 then isInvisible = false end
    if head and head.LocalTransparencyModifier < 1 then isInvisible = false end
    return isInvisible
end

