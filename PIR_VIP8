local function getBindName(bind)
    if bind == nil then return "NONE" end
    if typeof(bind) == "EnumItem" then
        if bind.EnumType == Enum.KeyCode then
            local n = tostring(bind):gsub("Enum.KeyCode.", "")
            local m = {LeftShift="SHIFT",RightShift="SHIFT",LeftControl="CTRL",RightControl="CTRL",LeftAlt="ALT",RightAlt="ALT",CapsLock="CAPS",Space="SPACE",Escape="ESC",Insert="INS",Delete="DEL",Backspace="BKSP",Return="ENTER",A="A",B="B",C="C",D="D",E="E",F="F",G="G",H="H",I="I",J="J",K="K",L="L",M="M",N="N",O="O",P="P",Q="Q",R="R",S="S",T="T",U="U",V="V",W="W",X="X",Y="Y",Z="Z",One="1",Two="2",Three="3",Four="4",Five="5",Six="6",Seven="7",Eight="8",Nine="9",Zero="0",F1="F1",F2="F2",F3="F3",F4="F4",F5="F5",F6="F6",F7="F7",F8="F8",F9="F9",F10="F10",F11="F11",F12="F12"}
            return m[n] or n
        elseif bind.EnumType == Enum.UserInputType then
            local n = tostring(bind):gsub("Enum.UserInputType.", "")
            local m = {MouseButton1="LMB",MouseButton2="RMB",MouseButton3="MMB"}
            return m[n] or n
        end
    end
    return "NONE"
end

local function deepCopy(t) if type(t) ~= "table" then return t end; local o = {}; for k,v in pairs(t) do o[k]=deepCopy(v) end; return o end
local function serializeValue(v)
    if typeof(v) == "EnumItem" then return { __enum = tostring(v.EnumType), name = v.Name } end
    if typeof(v) == "Color3" then return { __color = {v.R, v.G, v.B} } end
    if type(v) == "table" then local o={}; for k,val in pairs(v) do o[k]=serializeValue(val) end; return o end
    return v
end
local function deserializeValue(v)
    if type(v) ~= "table" then return v end
    if v and v.__enum and v.name then
        if v.__enum == "Enum.KeyCode" and Enum.KeyCode[v.name] then return Enum.KeyCode[v.name] end
        if v.__enum == "Enum.UserInputType" and Enum.UserInputType[v.name] then return Enum.UserInputType[v.name] end
    end
    if v and v.__color then return Color3.new(v.__color[1], v.__color[2], v.__color[3]) end
    local o={}; for k,val in pairs(v) do o[k]=deserializeValue(val) end; return o
end
local function deepMerge(t, s) for k, v in pairs(s) do if type(v) == "table" and type(t[k]) == "table" then deepMerge(t[k], v) else t[k] = v end end end

