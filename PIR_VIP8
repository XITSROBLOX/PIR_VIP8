local function setupClickTP()
    if clickTPConnection then clickTPConnection:Disconnect(); clickTPConnection = nil end
    if not Config.Player.ClickTPEnabled then return end

    clickTPConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not Config.Player.ClickTPEnabled then return end

        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        local cam = Workspace.CurrentCamera
        if not cam then return end

        local mousePos = UserInputService:GetMouseLocation()
        local screenPoint = Vector2.new(mousePos.X, mousePos.Y)
        local ray = cam:ViewportPointToRay(screenPoint.X, screenPoint.Y)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { myChar }
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, rp)
        if result and result.Position then
            saveCurrentPosition()
            local targetPos = result.Position + Vector3.new(0, 3, 0)
            pcall(function() myChar:PivotTo(CFrame.new(targetPos)) end)
            pcall(function() myHrp.CFrame = CFrame.new(targetPos) end)
        end
    end)
end

_G.FRH_SetupClickTP = setupClickTP

