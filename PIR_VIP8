local function refreshWhitelistUI()
    for pname, row in pairs(WhitelistRows) do
        if row.Frame and row.Frame.Parent then
            local visible = WL_SEARCH == "" or string.find(string.lower(pname), string.lower(WL_SEARCH), 1, true)
            row.Frame.Visible = visible
            if Config.Whitelist.Players[pname] then
                row.Frame.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
                row.Dot.BackgroundColor3 = C.WHITE
                row.Label.TextColor3 = C.WHITE
                row.TBtn.Text = "ON"
                row.TBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 85)
                row.Stroke.Color = C.WHITE
            else
                row.Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
                row.Dot.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                row.Label.TextColor3 = C.WHITE
                row.TBtn.Text = "OFF"
                row.TBtn.BackgroundColor3 = C.BG_INPUT
                row.Stroke.Color = Color3.fromRGB(30, 30, 42)
            end
        end
    end
    if WhitelistScroll then
        local l = WhitelistScroll:FindFirstChildOfClass("UIListLayout")
        if l then WhitelistScroll.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 6) end
    end
end

