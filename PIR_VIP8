local AMMO_CFG = { ValorAmmo = 999 }

local function refillAmmo(tool)
    if not tool then return end
    for _, child in pairs(tool:GetDescendants()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then
            local name = child.Name:lower()
            if name:find("ammo") or name:find("mag") or name:find("bullet") or name:find("clip") or
               name:find("ammunition") or name:find("round") or name:find("balas") or
               name:find("municao") or name:find("munition") or name:find("maxammo") or
               name:find("stored") or name:find("reserve") or name:find("currentammo") or
               name:find("ammocount") or name:find("ammunitioncount") then
                pcall(function() child.Value = AMMO_CFG.ValorAmmo end)
            end
        end
    end
end

local function applyWeaponMods()
    local char = LocalPlayer.Character
    if not char then return end

    local function processTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        if Config.Weapon.InfiniteAmmo then refillAmmo(tool) end
        for _, obj in pairs(tool:GetDescendants()) do
            if Config.Weapon.NoRecoil then
                pcall(function()
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local n = obj.Name:lower()
                        if n:find("recoil") or n:find("kick") or n:find("camera") then obj.Value = 0 end
                    end
                end)
            end
            if Config.Weapon.NoSpread then
                pcall(function()
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local n = obj.Name:lower()
                        if n:find("spread") or n:find("accuracy") or n:find("dispersion") then obj.Value = 0 end
                    end
                end)
            end
            if Config.Weapon.FireRate then
                pcall(function()
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local n = obj.Name:lower()
                        if n:find("firerate") or n:find("cooldown") or n:find("delay") or n:find("rate") then obj.Value = 0.01 end
                    end
                end)
            end
            if Config.Weapon.DamageBoost then
                pcall(function()
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local n = obj.Name:lower()
                        if n:find("damage") or n:find("dmg") then
                            if obj.Value > 0 then obj.Value = obj.Value * 5 end
                        end
                    end
                end)
            end
        end
    end

    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then processTool(tool) end
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then processTool(tool) end
        end
    end
end

_G.FRH_AmmoLoop = RunService.Heartbeat:Connect(function()
    if not (Config.Weapon.InfiniteAmmo or Config.Weapon.NoRecoil or Config.Weapon.NoSpread or Config.Weapon.FireRate or Config.Weapon.DamageBoost) then return end
    pcall(applyWeaponMods)
end)

