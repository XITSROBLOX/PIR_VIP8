                UserInputService.MouseDeltaSensitivity = aimOriginalMouseSensitivity or 1
                aimMouseLocked = false
            end
        end
    else
        if aimMouseLocked then
            UserInputService.MouseDeltaSensitivity = aimOriginalMouseSensitivity or 1
            aimMouseLocked = false
        end
    end
end)

