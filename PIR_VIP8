end

local function removeWhitelistRow(player)
    if WhitelistRows[player.Name] then WhitelistRows[player.Name].Frame:Destroy(); WhitelistRows[player.Name] = nil end
    Config.Whitelist.Players[player.Name] = nil
    refreshWhitelistUI()
end

