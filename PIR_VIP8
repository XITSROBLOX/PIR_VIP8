    if player == LocalPlayer then return end
    if not WhitelistScroll then return end
    if WhitelistRows[player.Name] then return end
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, -6, 0, 22); r.BackgroundColor3 = Color3.fromRGB(22, 22, 28); r.BorderSizePixel = 0; r.Parent = WhitelistScroll
    Instance.new("UICorner", r).CornerRadius = UDim.new(0, 4)
    local rs = Instance.new("UIStroke", r); rs.Color = Color3.fromRGB(30, 30, 42)
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 7, 0, 7); dot.Position = UDim2.new(0, 8, 0.5, -3)
    dot.BackgroundColor3 = Color3.fromRGB(60, 60, 70); dot.BorderSizePixel = 0; dot.Parent = r
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(0.6, 0, 1, 0); lb.Position = UDim2.new(0, 20, 0, 0); lb.BackgroundTransparency = 1
    lb.Text = player.Name; lb.TextColor3 = C.WHITE; lb.Font = FONT_BODY; lb.TextSize = 9
    lb.TextXAlignment = Enum.TextXAlignment.Left; lb.TextTruncate = Enum.TextTruncate.AtEnd; lb.Parent = r
