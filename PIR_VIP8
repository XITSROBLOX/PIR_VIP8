        Box = NewDrawing("Square", {Color = ESP_Colors.Box, Thickness = 1, Transparency = 1, Filled = false, Visible = false}),
        Snapline = NewDrawing("Line", {Color = ESP_Colors.Snapline, Thickness = 1, Transparency = 0.7, Visible = false}),
        FaceCircle = NewDrawing("Circle", {Color = ESP_Colors.Box, Thickness = 1, Filled = false, Visible = false}),
        HealthBg = NewDrawing("Line", {Color = Color3.new(0,0,0), Thickness = 2, Visible = false}),
        HealthBar = NewDrawing("Line", {Color = ESP_Colors.HealthBar, Thickness = 1, Visible = false}),
        Skeleton = {},
        CornerTL_H = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerTL_V = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerTR_H = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerTR_V = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerBL_H = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerBL_V = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerBR_H = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        CornerBR_V = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}),
        Billboard = nil,
        TopText = nil,
        BotText = nil,
        WeaponBillboard = nil,
        WeaponLabel = nil,
    }
    for i = 1, 14 do drawings.Skeleton[i] = NewDrawing("Line", {Color = ESP_Colors.Box, Thickness = 1, Visible = false}) end

    local bb, tt, bt = createBillboardFor(player.Name, player.Character)
    drawings.Billboard = bb
