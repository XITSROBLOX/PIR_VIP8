_G.FRH_MatchaDragLoop = UserInputService.InputChanged:Connect(function(input)
    if matchaDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and MatchaFrame then
        local delta = input.Position - matchaDragStart
        MatchaFrame.Position = UDim2.new(matchaStartPos.X.Scale, matchaStartPos.X.Offset + delta.X, matchaStartPos.Y.Scale, matchaStartPos.Y.Offset + delta.Y)
    end
end)

_G.FRH_MatchaLoop = RunService.RenderStepped:Connect(function(dt)
    if not MatchaFrame or not MatchaFrame.Parent then createMatchaFrame(); return end
    MatchaFrame.Visible = Config.Matcha.Enabled
    if Config.Matcha.Enabled then
        local fps = math.floor(1 / (dt > 0 and dt or 0.016))
        local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        local elapsed = math.floor(tick() - startTime)
        local mins = math.floor(elapsed / 60); local secs = elapsed % 60
        local info = MatchaFrame:FindFirstChild("Info")
        if info then
            local text = ""
            if Config.Matcha.ShowFPS then text = text .. "FPS: " .. fps .. "  " end
            if Config.Matcha.ShowPing then text = text .. "Ping: " .. ping .. "ms  " end
            text = text .. string.format("%02d:%02d", mins, secs)
            info.Text = text
        end
    end
end)

